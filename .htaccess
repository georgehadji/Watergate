# Ρυθμίσεις για Apache (κοινόχρηστη φιλοξενία, cPanel κ.λπ.)
# Οι security headers είναι ίδιοι με το _headers (Netlify / Cloudflare Pages). Δείτε εκεί τις εξηγήσεις.

Options -Indexes
ErrorDocument 404 /404.html
ServerSignature Off

# --- Ανακατεύθυνση σε HTTPS και σε www (TODO: αφαιρέστε το www αν το domain σας είναι χωρίς www) ---
<IfModule mod_rewrite.c>
  RewriteEngine On
  # Static site: μόνο GET/HEAD/OPTIONS (η φόρμα στέλνει στο Formspree, όχι εδώ). TRACE/PUT/DELETE κ.λπ. -> 405
  RewriteCond %{REQUEST_METHOD} !^(GET|HEAD|OPTIONS)$
  RewriteRule ^ - [R=405,L]
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} !^www\. [NC]
  RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
  RewriteRule ^ https://www.%1%{REQUEST_URI} [L,R=301]
  # /index.html -> /
  RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
  RewriteRule ^index\.html$ / [L,R=301]
  # Μην εξυπηρετείτε κρυφά/εσωτερικά αρχεία (επιτρέπεται μόνο το /.well-known/)
  RewriteRule (^|/)\.(?!well-known/) - [F]
  RewriteRule ^(README\.md|_headers)$ - [F]
</IfModule>

# Αρχεία που δεν πρέπει ποτέ να σερβίρονται (backup, logs, ρυθμίσεις, scripts, σημειώσεις)
<FilesMatch "\.(bak|old|orig|save|swp|tmp|log|sql|sqlite|db|ini|conf|env|sh|py|md|yml|yaml|lock)$">
  Require all denied
</FilesMatch>

# --- Security headers ---
<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; manifest-src 'self'; connect-src 'self' https://formspree.io; frame-src https://www.google.com https://maps.google.com; form-action 'self' https://formspree.io; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; require-trusted-types-for 'script'; trusted-types 'none'; upgrade-insecure-requests"
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains" "expr=%{HTTPS} == 'on'"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set X-XSS-Protection "0"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "accelerometer=(), autoplay=(), browsing-topics=(), camera=(), display-capture=(), encrypted-media=(), fullscreen=(self \"https://www.google.com\"), geolocation=(), gyroscope=(), hid=(), idle-detection=(), magnetometer=(), microphone=(), midi=(), payment=(), picture-in-picture=(), publickey-credentials-get=(), screen-wake-lock=(), serial=(), usb=(), xr-spatial-tracking=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set X-Permitted-Cross-Domain-Policies "none"
  Header always set Origin-Agent-Cluster "?1"
  Header unset X-Powered-By
  Header always unset X-Powered-By
  # Scripts, styles, fonts: μόνο για αυτό το site. Οι εικόνες μένουν ανοιχτές για τα share previews.
  <FilesMatch "\.(js|css|woff2)$">
    Header always set Cross-Origin-Resource-Policy "same-origin"
  </FilesMatch>
</IfModule>

# --- Συμπίεση ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/plain application/xml application/manifest+json
</IfModule>

# --- Caching ---
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
</IfModule>

AddType font/woff2 .woff2
AddType application/manifest+json .webmanifest
AddDefaultCharset utf-8
